# Projenin genel bilgileri
PROJECT_NAME           = "C Programlama Alıştırmaları"
PROJECT_BRIEF          = "C programlama ve yazılım mühendisliği alıştırmaları"
OUTPUT_LANGUAGE        = Turkish
OUTPUT_DIRECTORY       = build/docs/doxygen

# Kaynaklar
INPUT                  = .
FILE_PATTERNS          = *.c \
                         *.h \
                         *.md
RECURSIVE              = YES
EXCLUDE                = build
EXCLUDE_PATTERNS       = */.git/* \
                         */build/*
USE_MDFILE_AS_MAINPAGE = README.md

# C projeleri için tarama ayarları
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# Kaynak kod gezintisi
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# Uyarılar
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO

# HTML çıktısı
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES

# Bu depoda PDF/LaTeX çıktısı şimdilik kullanılmıyor
GENERATE_LATEX         = NO

# Graphviz diyagramları
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
